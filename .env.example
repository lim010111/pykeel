# pykeel이 읽는 API 키. 이 파일을 .env로 복사해 값을 채운다: cp .env.example .env
# .env는 .gitignore에 있어 커밋되지 않는다. 이 파일(.env.example)에는 값을 넣지 않는다.
#
# 이름은 _API_KEY, _TOKEN, _SECRET, _PASSWORD 중 하나로 끝나야 한다.
# 그래야 비밀값 검사(scripts/secret_scan.py)가 실제 값이 커밋되는지 찾는다.
#
# 읽는 법: uv run --env-file .env <명령>
# pytest도 이렇게 돌려야 실제 값까지 검사한다. pre-commit hook은 .env가 있으면 알아서 읽는다.

# pykeel 전용 OpenAI 프로젝트(월 hard spend limit을 건 프로젝트)의 키. Responses API에 쓴다.
OPENAI_API_KEY=

# EXAONE API Platform 키. 유효기간은 발급일로부터 30일이다. Chat Completions에 쓴다.
EXAONE_API_KEY=
